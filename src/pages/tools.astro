---
import PageHeader from "@/components/PageHeader";
import SiteFooter from "@/components/SiteFooter.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  TOOL_CATEGORIES,
  gridPoster,
  publishedTools,
  toolCategoryLabel,
  toolHost,
} from "@/lib/tools";
---

<BaseLayout
  title="Tools — whatships.com"
  description="A curated directory of editors, motion tools, and mockup tools for making launch videos or mockups."
>
  <PageHeader active="tools" client:idle />
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <h1 id="hero-title">Tools for making launch videos or mockups</h1>
        <p class="hero__copy">
          A curated set of editors, motion tools, and mockup tools
          for product films.
        </p>
      </div>
    </section>

    <section
      class="directory"
      id="directory"
      aria-labelledby="hero-title"
    >
      <div class="tool-filters" role="radiogroup" aria-label="Filter by category">
        {
          [{ id: "all", label: "All" }, ...TOOL_CATEGORIES].map((item) => (
            <label class="tool-filter" for={`tool-cat-${item.id}`}>
              <input
                class="tool-filter-input"
                type="radio"
                name="tool-cat"
                id={`tool-cat-${item.id}`}
                value={item.id}
                checked={item.id === "all"}
              />
              {item.label}
            </label>
          ))
        }
      </div>
      <div class="video-grid">
        {
          publishedTools.map((tool, index) => {
            const small = gridPoster(tool.poster);
            const host = toolHost(tool.url);
            const category = toolCategoryLabel(tool.category);
            return (
              <article class="video-card" data-category={tool.category}>
                <span class="corner one" aria-hidden="true" />
                <span class="corner two" aria-hidden="true" />
                <span class="corner three" aria-hidden="true" />
                <span class="corner four" aria-hidden="true" />
                <div class="video-card__main">
                  <p class="video-card__kicker">{category}</p>
                  <a
                    class="video-card__media"
                    href={tool.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Open ${tool.name} website`}
                  >
                    <img
                      src={small}
                      srcset={`${small} 960w, ${tool.poster} 1440w`}
                      sizes="(max-width: 699px) calc(100vw - 34px), 420px"
                      alt={`${tool.name} — ${tool.tagline}`}
                      loading={index < 6 ? "eager" : "lazy"}
                      fetchpriority={index === 0 ? "high" : undefined}
                      width="1440"
                      height="810"
                    />
                    <span class="video-card__hover-label" aria-hidden="true">
                      <span>Visit site</span>
                    </span>
                  </a>
                  <div class="video-card__body">
                    <div>
                      <h2>
                        <a href={tool.url} target="_blank" rel="noopener noreferrer">
                          {tool.name}
                        </a>
                      </h2>
                      <p class="video-card__location">{tool.tagline}</p>
                      <p class="video-card__meta">{host}</p>
                    </div>
                  </div>
                </div>
                <a
                  class="video-card__external"
                  href={tool.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open ${tool.name} website`}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="17"
                    height="17"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M15 3h6v6"></path>
                    <path d="M10 14 21 3"></path>
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  </svg>
                </a>
              </article>
            );
          })
        }
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .tool-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0 0 16px;
  }
  .tool-filter-input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }
  .tool-filter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    padding: 0 10px;
    border: 0.5px solid var(--grid-line);
    border-radius: 0;
    background: var(--card);
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .tool-filter:hover {
    color: var(--foreground);
    border-color: var(--n-400);
  }
  .tool-filter:has(.tool-filter-input:checked) {
    background: var(--foreground);
    border-color: var(--foreground);
    color: var(--background);
  }
  .tool-filter:has(.tool-filter-input:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  .video-card__kicker {
    margin: 0 0 8px;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 16px;
    text-transform: uppercase;
  }
  .directory .video-card__external {
    top: 46px;
  }
  @media (max-width: 699px) {
    .tool-filter {
      min-height: 44px;
      padding: 0 12px;
    }
  }
  .directory:has(#tool-cat-ai:checked) .video-card:not([data-category="ai"]),
  .directory:has(#tool-cat-editor:checked) .video-card:not([data-category="editor"]),
  .directory:has(#tool-cat-motion:checked) .video-card:not([data-category="motion"]),
  .directory:has(#tool-cat-mockup:checked) .video-card:not([data-category="mockup"]),
  .directory:has(#tool-cat-skills:checked) .video-card:not([data-category="skills"]) {
    display: none;
  }
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const category = params.get("category");
  if (category) {
    const selected = document.getElementById(`tool-cat-${category}`);
    if (selected instanceof HTMLInputElement) selected.checked = true;
  }

  document.querySelectorAll<HTMLInputElement>('input[name="tool-cat"]').forEach((input) => {
    input.addEventListener("change", () => {
      if (!input.checked) return;
      const url = new URL(window.location.href);
      if (input.value === "all") url.searchParams.delete("category");
      else url.searchParams.set("category", input.value);
      history.replaceState(null, "", url);
    });
  });
</script>
