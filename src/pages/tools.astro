---
import PageHeader from "@/components/PageHeader";
import SiteFooter from "@/components/SiteFooter.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  TOOL_CATEGORIES,
  formatStars,
  formatStarsDetail,
  gridPoster,
  publishedTools,
  toolCategoryLabel,
  toolHost,
} from "@/lib/tools";
---

<BaseLayout
  title="Tools — What Ships"
  description="A curated What Ships directory of editors, motion tools, mockup tools, and AI tools for making product launch videos or product mockups too."
>
  <PageHeader active="tools" client:idle />
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <h1 id="hero-title">Tools for making launch videos or mockups</h1>
        <p class="hero__copy">
          A curated set of editors, motion tools, and mockup tools
          for product films.
        </p>
      </div>
    </section>

    <section
      class="directory"
      id="directory"
      aria-labelledby="hero-title"
    >
      <div class="tool-filters" role="radiogroup" aria-label="Filter by category">
        {
          [{ id: "all", label: "All" }, ...TOOL_CATEGORIES].map((item) => (
            <label class="tool-filter" for={`tool-cat-${item.id}`}>
              <input
                class="tool-filter-input"
                type="radio"
                name="tool-cat"
                id={`tool-cat-${item.id}`}
                value={item.id}
                checked={item.id === "all"}
              />
              {item.label}
            </label>
          ))
        }
      </div>
      <div class="video-grid">
        {
          publishedTools.map((tool, index) => {
            const small = gridPoster(tool.poster);
            const bust = tool.category === "skills" ? "?v=4" : "";
            const host = toolHost(tool.url);
            const category = toolCategoryLabel(tool.category);
            const stars = formatStars(tool.stars);
            const starsDetail = formatStarsDetail(tool);
            return (
              <article class="video-card" id={tool.id} data-category={tool.category}>
                <span class="corner one" aria-hidden="true" />
                <span class="corner two" aria-hidden="true" />
                <span class="corner three" aria-hidden="true" />
                <span class="corner four" aria-hidden="true" />
                <div class="video-card__main">
                  <p class="video-card__kicker">{category}</p>
                  <a
                    class="video-card__media"
                    href={tool.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Open ${tool.name} website`}
                  >
                    <img
                      src={`${small}${bust}`}
                      srcset={`${small}${bust} 960w, ${tool.poster}${bust} 1440w`}
                      sizes="(max-width: 699px) calc(100vw - 34px), 420px"
                      alt={`${tool.name} — ${tool.tagline}`}
                      loading={index < 6 ? "eager" : "lazy"}
                      fetchpriority={index === 0 ? "high" : undefined}
                      width="1440"
                      height="810"
                    />
                    {
                      tool.category === "skills" && stars && (
                        <span
                          class="video-card__stars"
                          title={starsDetail ?? undefined}
                          aria-hidden="true"
                        >
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="10"
                            height="10"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M12 2.6 15 9l7 .8-5.2 4.7 1.5 6.9L12 17.9 5.7 21.4l1.5-6.9L2 9.8 9 9Z" />
                          </svg>
                          {stars}
                        </span>
                      )
                    }
                  </a>
                  <div class="video-card__body">
                    <div>
                      <h2>
                        <a href={tool.url} target="_blank" rel="noopener noreferrer">
                          {tool.name}
                        </a>
                      </h2>
                      <p class="video-card__location">{tool.tagline}</p>
                      {/* Host line only for non-skill tools — skills cards
                          carry the GitHub stars chip instead. */}
                      {tool.category !== "skills" && (
                        <p class="video-card__meta">{host}</p>
                      )}
                    </div>
                  </div>
                </div>
                <a
                  class="video-card__external"
                  href={tool.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open ${tool.name} website`}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="11"
                    height="11"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 7h10v10" />
                    <path d="M7 17 17 7" />
                  </svg>
                </a>
              </article>
            );
          })
        }
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .tool-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0 0 16px;
  }
  .tool-filter-input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }
  .tool-filter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    padding: 0 10px;
    border: 0.5px solid var(--grid-line);
    border-radius: 0;
    background: var(--card);
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--duration-quick) ease, border-color var(--duration-quick) ease;
  }
  .tool-filter:hover {
    color: var(--foreground);
    border-color: var(--n-400);
  }
  .tool-filter:has(.tool-filter-input:checked) {
    background: var(--foreground);
    border-color: var(--foreground);
    color: var(--background);
  }
  .tool-filter:has(.tool-filter-input:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  .video-card__kicker {
    margin: 0 0 8px;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 16px;
    text-transform: uppercase;
  }
  /* 12px card pad + 16px kicker + 8px kicker margin + 9px media inset. The
     external arrow sits bottom-right so it never collides with the stars
     chip in the media's top-right corner. */
  .directory .video-card__external {
    top: auto;
    bottom: 21px;
  }
  /* GitHub stars chip, top-right of the preview — agentskills.me-style pill
     (rounded, stacked over the poster) on the site's mono chrome. Star
     counts are a snapshot; the title carries the exact count + date. */
  .directory .video-card__stars {
    position: absolute;
    z-index: 1;
    top: 8px;
    right: 8px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgb(15 23 42 / 55%);
    color: rgb(255 255 255 / 95%);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }
  .directory .video-card__stars svg {
    flex: none;
  }
  @media (max-width: 699px) {
    .tool-filter {
      min-height: 44px;
      padding: 0 12px;
    }
  }
  .directory:has(#tool-cat-ai:checked) .video-card:not([data-category="ai"]),
  .directory:has(#tool-cat-editor:checked) .video-card:not([data-category="editor"]),
  .directory:has(#tool-cat-motion:checked) .video-card:not([data-category="motion"]),
  .directory:has(#tool-cat-mockup:checked) .video-card:not([data-category="mockup"]),
  .directory:has(#tool-cat-skills:checked) .video-card:not([data-category="skills"]),
  .directory:has(#tool-cat-resources:checked) .video-card:not([data-category="resources"]) {
    display: none;
  }
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const category = params.get("category");
  if (category) {
    const selected = document.getElementById(`tool-cat-${category}`);
    if (selected instanceof HTMLInputElement) selected.checked = true;
  }

  document.querySelectorAll<HTMLInputElement>('input[name="tool-cat"]').forEach((input) => {
    input.addEventListener("change", () => {
      if (!input.checked) return;
      const url = new URL(window.location.href);
      if (input.value === "all") url.searchParams.delete("category");
      else url.searchParams.set("category", input.value);
      history.replaceState(null, "", url);
    });
  });
</script>
