---
import { ArrowUpRight, Play } from "lucide-react";
import DetailPlayer from "@/components/DetailPlayer";
import PageHeader from "@/components/PageHeader";
import SiteFooter from "@/components/SiteFooter.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  categoryLabel,
  formatDuration,
  formatPublishedAt,
  getSimilarVideos,
  normalizeTweetUrl,
  playbackUrl,
  publishedVideos,
  type LaunchVideo,
  xProfileUrl,
} from "@/lib/catalog";
import { gridPoster } from "@/lib/directory";
import {
  SITE_DATE_MODIFIED,
  SITE_NAME,
  SITE_URL,
} from "@/lib/site";

export async function getStaticPaths() {
  const total = publishedVideos.length;

  return publishedVideos.map((video, index) => ({
    params: { slug: video.slug },
    props: {
      video,
      position: index + 1,
      total,
    },
  }));
}

interface Props {
  video: LaunchVideo;
  position: number;
  total: number;
}

const { video, position, total } = Astro.props;
const description =
  video.description ||
  `${video.title} — a product launch video from ${video.company} on X.`;
const counterWidth = String(total).length;
const positionLabel = String(position).padStart(counterWidth, "0");
const totalLabel = String(total).padStart(counterWidth, "0");
const monogram = video.company.trim().slice(0, 1).toUpperCase();
const similarVideos = getSimilarVideos(video);
const duration = formatDuration(video.durationSeconds);
const handle = video.authorHandle.replace(/^@/, "");
const tweetUrl = normalizeTweetUrl(video.tweetUrl);
const categoryLabelLower = categoryLabel(video.category).toLowerCase();
const categoryCount = publishedVideos.filter(
  (candidate) => candidate.category === video.category,
).length;
const possessiveCompany = video.company ? `${video.company}'s ` : "";

// Extractable definition block: identity sentence the catalog can back up.
const definition = [
  `${video.product} is ${possessiveCompany}${categoryLabelLower} ${
    video.category === "motion" ? "film" : "launch film"
  }, posted on X by @${handle} on ${formatPublishedAt(video.publishedAt)}.`,
  duration
    ? `The ${duration} film is archived here as entry ${positionLabel} of ${totalLabel} in the whatships.com catalog, with a durable link back to the original X post.`
    : `It is archived here as entry ${positionLabel} of ${totalLabel} in the whatships.com catalog, with a durable link back to the original X post.`,
].join(" ");

const entryFaqs = [
  {
    question: `What is ${video.product}?`,
    answer: definition,
  },
  {
    question: `When did ${video.product} launch?`,
    answer: `${formatPublishedAt(video.publishedAt)} — the film was posted on X by @${handle}.`,
  },
  {
    question: `Where can I watch ${video.product}'s launch video?`,
    answer:
      'On this page: the player at the top streams the film, and the original post is linked under "Original → View on X".',
  },
];

// VideoObject structured data for video rich results.
const site = Astro.site ?? SITE_URL;
const pageUrl = new URL(`/videos/${video.slug}/`, site).toString();
const posterUrl = new URL(video.poster, site).toString();
const contentUrl = new URL(playbackUrl(video), site).toString();
const durationIso =
  video.durationSeconds && video.durationSeconds > 0
    ? `PT${Math.floor(video.durationSeconds / 60)}M${Math.round(video.durationSeconds % 60)}S`
    : undefined;
const videoJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: video.title,
      description,
      inLanguage: "en",
      datePublished: video.publishedAt,
      dateModified: SITE_DATE_MODIFIED,
      isPartOf: { "@id": `${SITE_URL}/#website` },
      about: { "@id": `${pageUrl}#video` },
      mainEntity: { "@id": `${pageUrl}#video` },
      author: {
        "@type": "Person",
        name: video.authorName,
        url: xProfileUrl(handle),
      },
      publisher: { "@id": `${SITE_URL}/#organization` },
      speakable: {
        "@type": "SpeakableSpecification",
        cssSelector: ["#video-title", ".detail-fact--about dd"],
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: SITE_NAME,
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: video.title,
          item: pageUrl,
        },
      ],
    },
    {
      "@type": "VideoObject",
      "@id": `${pageUrl}#video`,
      name: video.title,
      description,
      thumbnailUrl: posterUrl,
      uploadDate: video.publishedAt,
      ...(durationIso ? { duration: durationIso } : {}),
      contentUrl,
      embedUrl: pageUrl,
      url: pageUrl,
      author: {
        "@type": "Person",
        name: video.authorName,
        url: xProfileUrl(handle),
      },
      publisher: { "@id": `${SITE_URL}/#organization` },
      isPartOf: { "@id": `${pageUrl}#webpage` },
      keywords: video.tags.join(", "),
      citation: tweetUrl,
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      url: pageUrl,
      inLanguage: "en",
      isPartOf: { "@id": `${pageUrl}#webpage` },
      mainEntity: entryFaqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title={`${video.title} — whatships.com`}
  description={description}
  image={video.poster}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={gridPoster(video.poster)}
    fetchpriority="high"
    type="image/webp"
  />
  <PageHeader client:idle />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(videoJsonLd)}
  />
  <main class="video-detail">
    <div class="detail-utility">
      <a
        class="detail-close"
        href="/#directory"
        aria-label="Close video detail"
        aria-keyshortcuts="Escape"
        data-detail-close
      >
        <span>Close</span>
        <kbd>Esc</kbd>
      </a>
      <div class="detail-logo">
        {
          video.authorAvatar ? (
            <img
              src={video.authorAvatar}
              alt={`${video.authorName} on X`}
              referrerpolicy="no-referrer"
            />
          ) : (
            <span class="detail-logo__fallback" aria-hidden="true">
              {monogram}
            </span>
          )
        }
      </div>
      <p class="detail-counter" aria-label={`Video ${position} of ${total}`}>
        {positionLabel} / {totalLabel}
      </p>
    </div>

    <article class="detail-profile" aria-labelledby="video-title">
      <DetailPlayer client:idle video={video} />

      <h1 id="video-title">{video.title}</h1>

      <dl class="detail-facts">
        <div class="detail-fact detail-fact--about">
          <dt>About</dt>
          <dd>{description}</dd>
        </div>
        <div class="detail-fact">
          <dt>Product</dt>
          <dd>{video.product}</dd>
        </div>
        <div class="detail-fact">
          <dt>Company</dt>
          <dd>{video.company}</dd>
        </div>
        <div class="detail-fact">
          <dt>Category</dt>
          <dd>{categoryLabel(video.category)}</dd>
        </div>
        <div class="detail-fact">
          <dt>Posted</dt>
          <dd>{formatPublishedAt(video.publishedAt)}</dd>
        </div>
        {
          duration && (
            <div class="detail-fact">
              <dt>Duration</dt>
              <dd>{duration}</dd>
            </div>
          )
        }
        <div class="detail-fact">
          <dt>Author</dt>
          <dd>
            <a
              class="detail-website t-learn"
              href={xProfileUrl(handle)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open @${handle} on X`}
            >
              <span>@{handle}</span>
              <span class="t-learn-chevron" aria-hidden="true">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                >
                  <path class="t-learn-arm t-learn-arm-top" d="M6 4L10 8"></path>
                  <path class="t-learn-arm t-learn-arm-bot" d="M10 8L6 12"></path>
                </svg>
              </span>
            </a>
          </dd>
        </div>
        <div class="detail-fact">
          <dt>Original</dt>
          <dd>
            <a
              class="detail-website t-learn"
              href={tweetUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open original post for ${video.title}`}
            >
              <span>View on X</span>
              <span class="t-learn-chevron" aria-hidden="true">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                >
                  <path class="t-learn-arm t-learn-arm-top" d="M6 4L10 8"></path>
                  <path class="t-learn-arm t-learn-arm-bot" d="M10 8L6 12"></path>
                </svg>
              </span>
            </a>
          </dd>
        </div>
        {
          video.tags.length > 0 && (
            <div class="detail-fact">
              <dt>Tags</dt>
              <dd>{video.tags.join(" · ")}</dd>
            </div>
          )
        }
      </dl>
    </article>

    <section class="detail-insights" aria-label="Details about this launch">
      <div class="insight">
        <h2>What is {video.product}?</h2>
        <p>{definition}</p>
      </div>
      <div class="insight">
        <h2>This launch by the numbers</h2>
        <ul>
          <li>
            <strong>Posted</strong> {formatPublishedAt(video.publishedAt)} on
            X by @{handle}
          </li>
          {
            duration && (
              <li>
                <strong>Runtime</strong> {duration}
              </li>
            )
          }
          <li>
            <strong>Entry</strong> {positionLabel} of {totalLabel} in the
            catalog
          </li>
          <li>
            <strong>Peers</strong> {categoryCount} launches indexed in{" "}
            {categoryLabel(video.category)}
          </li>
        </ul>
      </div>
      <div class="insight">
        <h2>On the X timeline vs. whatships.com</h2>
        <table>
          <thead>
            <tr>
              <th scope="col">On the X timeline</th>
              <th scope="col">On whatships.com</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Sinks below newer posts within hours</td>
              <td>Stable page that stays findable</td>
            </tr>
            <tr>
              <td>Post text and replies</td>
              <td>Product, company, category, duration, and tags</td>
            </tr>
            <tr>
              <td>Scattered across accounts and algorithms</td>
              <td>{categoryCount} {categoryLabel(video.category)} launches linked below</td>
            </tr>
            <tr>
              <td>Post URL only</td>
              <td>Directory entry plus the original post URL</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="insight">
        <h2>How to study this launch</h2>
        <ol>
          <li>
            Watch the {duration ? `${duration} film` : "film"} top to bottom —
            note the opening hook and the payoff shot.
          </li>
          <li>
            Read the About line and tags to see what {video.product} actually
            ships.
          </li>
          <li>
            Open the <a href={tweetUrl} target="_blank" rel="noopener noreferrer">original X post</a>
            to read the launch-day conversation as it happened.
          </li>
          <li>
            Compare with the {categoryLabel(video.category)} launches linked
            below, or browse the{" "}
            <a href="/studios/">studios directory</a> for the people who made
            the film.
          </li>
        </ol>
      </div>
      <div class="insight">
        <h2>Frequently asked questions</h2>
        <dl class="insight-faq">
          {
            entryFaqs.map((faq) => (
              <div>
                <dt>{faq.question}</dt>
                <dd>{faq.answer}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="similar-videos" aria-labelledby="similar-videos-title">
      <h2 id="similar-videos-title">
        Explore similar launches to {video.product}
      </h2>
      <div class="video-grid">
        {
          similarVideos.map((similar) => (
            <article class="video-card">
              <span class="corner one" aria-hidden="true" />
              <span class="corner two" aria-hidden="true" />
              <span class="corner three" aria-hidden="true" />
              <span class="corner four" aria-hidden="true" />
              <a
                class="video-card__main"
                href={`/videos/${similar.slug}/`}
                aria-label={`View ${similar.title}`}
              >
                <div class="video-card__media">
                  <img
                    src={similar.poster.replace(/\.webp$/, "-960.webp")}
                    srcset={`${similar.poster.replace(/\.webp$/, "-960.webp")} 960w, ${similar.poster} 1440w`}
                    sizes="(max-width: 699px) calc(100vw - 34px), 300px"
                    alt={`Poster for ${similar.title}`}
                    loading="lazy"
                    width="1440"
                    height="810"
                  />
                  <span class="video-card__play" aria-hidden="true">
                    <Play size={18} fill="currentColor" />
                  </span>
                  <span class="video-card__hover-label" aria-hidden="true">
                    <span>{similar.company}</span>
                  </span>
                </div>
                <div class="video-card__body">
                  <div>
                    <h3>{similar.title}</h3>
                    <p class="video-card__meta">
                      {similar.company}
                      <span aria-hidden="true"> · </span>
                      {categoryLabel(similar.category)}
                    </p>
                  </div>
                </div>
              </a>
              <a
                class="video-card__external"
                href={normalizeTweetUrl(similar.tweetUrl)}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Open original post for ${similar.title} on X`}
              >
                <ArrowUpRight size={17} aria-hidden="true" />
              </a>
            </article>
          ))
        }
      </div>
    </section>
  </main>
  <SiteFooter />

  <script>
    const closeLink = document.querySelector("[data-detail-close]");

    function returnFromDetail() {
      let hasSameOriginReferrer = false;
      try {
        hasSameOriginReferrer =
          new URL(document.referrer).origin === window.location.origin;
      } catch {
        hasSameOriginReferrer = false;
      }

      if (hasSameOriginReferrer && window.history.length > 1) {
        window.history.back();
        return;
      }

      window.location.href = "/#directory";
    }

    closeLink?.addEventListener("click", (event) => {
      event.preventDefault();
      returnFromDetail();
    });

    window.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const target = event.target;
      if (
        target instanceof HTMLElement &&
        (target.matches("input, textarea, select") || target.isContentEditable)
      )
        return;
      if (document.querySelector("[data-slot='dialog-content']")) return;
      event.preventDefault();
      returnFromDetail();
    });
  </script>
</BaseLayout>
