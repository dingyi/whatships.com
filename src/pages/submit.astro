---
import PageHeader from "@/components/PageHeader";
import SiteFooter from "@/components/SiteFooter.astro";
import SubmitForm from "@/components/SubmitForm";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Submit — whatships.com"
  description="Submit a launch video, tool, studio, or designer for editorial review on whatships.com. The form opens a GitHub issue; nothing ships until a human reviews it."
>
  <PageHeader active="submit" client:idle />
  <main class="submit-page">
    <SubmitForm client:load />
  </main>
  <SiteFooter />
</BaseLayout>
