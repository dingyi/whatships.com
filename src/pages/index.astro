---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HomeApp from "@/components/HomeApp";
import SiteFooter from "@/components/SiteFooter.astro";
import { publishedVideos } from "@/lib/catalog";
import { PAGE_SIZE, gridPoster, toDirectoryVideo } from "@/lib/directory";
import { homepageJsonLd } from "@/lib/schema";
import {
  HOMEPAGE_H1,
  HOMEPAGE_INTRO,
  SITE_META_DESCRIPTION,
  SITE_NAME,
} from "@/lib/site";

const firstPage = publishedVideos.slice(0, PAGE_SIZE).map(toDirectoryVideo);
const lcpPoster = firstPage[0] ? gridPoster(firstPage[0].poster) : null;
const introParagraphs = HOMEPAGE_INTRO.trim().split(/\n\n+/);
---

<BaseLayout
  title={`${SITE_NAME} — Discover startup launch videos`}
  description={SITE_META_DESCRIPTION}
>
  {
    lcpPoster && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={lcpPoster}
        fetchpriority="high"
        type="image/webp"
      />
    )
  }
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(homepageJsonLd())}
  />
  {/* Crawler copy outside the HomeApp island (AGENTS.md): one H1 plus the
      site intro, so agents that skip custom elements still see the summary.
      Kept to real editorial copy — no FAQ/citation padding. */}
  <section class="sr-only" data-agent-intro>
    <h1>{SITE_NAME} — {HOMEPAGE_H1}</h1>
    {introParagraphs.map((paragraph) => <p>{paragraph}</p>)}
  </section>
  <HomeApp
    videos={firstPage}
    totalCount={publishedVideos.length}
    client:idle
  />
  <SiteFooter />
  <script is:inline>
    if (window.location.search) {
      const meta = document.createElement("meta");
      meta.name = "robots";
      meta.content = "noindex,follow";
      document.head.appendChild(meta);
    }
  </script>
</BaseLayout>
