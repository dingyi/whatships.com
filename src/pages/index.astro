---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HomeApp from "@/components/HomeApp";
import PageHeader from "@/components/PageHeader";
import SiteFooter from "@/components/SiteFooter.astro";
import { publishedVideos } from "@/lib/catalog";
import { PAGE_SIZE, gridPoster, toDirectoryVideo } from "@/lib/directory";
import { homepageJsonLd } from "@/lib/schema";
import {
  HOMEPAGE_H1,
  HOMEPAGE_INTRO,
  HOMEPAGE_TITLE,
  SITE_META_DESCRIPTION,
  SITE_NAME,
} from "@/lib/site";

const firstPage = publishedVideos.slice(0, PAGE_SIZE).map(toDirectoryVideo);
const lcpPoster = firstPage[0] ? gridPoster(firstPage[0].poster) : null;
const introParagraphs = HOMEPAGE_INTRO.trim().split(/\n\n+/);
// The ItemList mirrors the newest entries already in the HTML grid; capped so
// the JSON-LD block stays small.
const jsonLd = homepageJsonLd(
  firstPage.slice(0, 20).map((video) => ({
    title: video.title,
    slug: video.slug,
    company: video.company,
    description: video.description,
  })),
);
---

<BaseLayout title={HOMEPAGE_TITLE} description={SITE_META_DESCRIPTION}>
  {
    lcpPoster && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={lcpPoster}
        fetchpriority="high"
        type="image/webp"
      />
    )
  }
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
  <PageHeader active="discover" client:idle />
  {/* H1 and site intro live outside the HomeApp island (AGENTS.md) so agents
      that skip custom elements still see them. Both are visible to people
      too: crawler-only copy would be hidden text under Google's spam policy. */}
  <main>
    <section class="hero" data-agent-intro>
      <div class="hero__inner">
        <h1>{HOMEPAGE_H1}</h1>
        <p class="hero__copy">
          A curated edit of product launch videos, demos, and walkthroughs from
          startups introducing new products to the world.
        </p>
      </div>
    </section>
    <HomeApp
      videos={firstPage}
      totalCount={publishedVideos.length}
      client:idle
    />
    <section
      class="home-about"
      aria-labelledby="home-about-title"
      data-agent-intro
    >
      <h2 id="home-about-title">About {SITE_NAME}</h2>
      {introParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </section>
  </main>

  <SiteFooter />
  <script is:inline>
    if (window.location.search) {
      const meta = document.createElement("meta");
      meta.name = "robots";
      meta.content = "noindex,follow";
      document.head.appendChild(meta);
    }
  </script>
</BaseLayout>

