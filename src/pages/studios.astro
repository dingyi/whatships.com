---
import PageHeader from "@/components/PageHeader";
import SiteFooter from "@/components/SiteFooter.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  STUDIO_KINDS,
  gridPoster,
  publishedStudios,
  studioHost,
  studioKindLabel,
} from "@/lib/studios";
---

<BaseLayout
  title="Studios — whatships.com"
  description="A curated directory of studios and independent designers that make product launch videos."
>
  <PageHeader active="studios" client:load />
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <h1 id="hero-title">Studios and makers that make launch videos</h1>
        <p class="hero__copy">
          Motion studios and independent designers that specialize in
          product launch films.
        </p>
      </div>
    </section>

    <section
      class="directory"
      id="directory"
      aria-labelledby="hero-title"
    >
      <div class="studio-filters" role="radiogroup" aria-label="Filter by kind">
        {
          [{ id: "all", label: "All" }, ...STUDIO_KINDS].map((item) => (
            <label class="studio-filter" for={`studio-kind-${item.id}`}>
              <input
                class="studio-filter-input"
                type="radio"
                name="studio-kind"
                id={`studio-kind-${item.id}`}
                value={item.id}
                checked={item.id === "all"}
              />
              {item.label}
            </label>
          ))
        }
      </div>
      <div class="video-grid">
        {
          publishedStudios.map((studio, index) => {
            const small = gridPoster(studio.poster);
            const host = studioHost(studio.url);
            const kind = studioKindLabel(studio.kind);
            return (
              <article class="video-card" data-kind={studio.kind}>
                <span class="corner one" aria-hidden="true" />
                <span class="corner two" aria-hidden="true" />
                <span class="corner three" aria-hidden="true" />
                <span class="corner four" aria-hidden="true" />
                <div class="video-card__main">
                  <p class="video-card__kicker">{kind}</p>
                  <a
                    class="video-card__media"
                    href={studio.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Open ${studio.name} website`}
                  >
                    <img
                      src={small}
                      srcset={`${small} 960w, ${studio.poster} 1440w`}
                      sizes="(max-width: 699px) calc(100vw - 34px), 420px"
                      alt={`${studio.name} — ${studio.tagline}`}
                      loading={index < 6 ? "eager" : "lazy"}
                      fetchpriority={index === 0 ? "high" : undefined}
                      width="1440"
                      height="810"
                    />
                    <span class="video-card__hover-label" aria-hidden="true">
                      <span>Visit site</span>
                    </span>
                  </a>
                  <div class="video-card__body">
                    <div>
                      <h2>
                        <a href={studio.url} target="_blank" rel="noopener noreferrer">
                          {studio.name}
                        </a>
                      </h2>
                      <p class="video-card__location">{studio.tagline}</p>
                      <p class="video-card__meta">{host}</p>
                    </div>
                  </div>
                </div>
                <a
                  class="video-card__external"
                  href={studio.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open ${studio.name} website`}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="17"
                    height="17"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M15 3h6v6"></path>
                    <path d="M10 14 21 3"></path>
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  </svg>
                </a>
              </article>
            );
          })
        }
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .studio-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0 0 16px;
  }
  .studio-filter-input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }
  .studio-filter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    padding: 0 10px;
    border: 0.5px solid var(--grid-line);
    border-radius: 0;
    background: var(--card);
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .studio-filter:hover {
    color: var(--foreground);
    border-color: var(--n-400);
  }
  .studio-filter:has(.studio-filter-input:checked) {
    background: var(--foreground);
    border-color: var(--foreground);
    color: var(--background);
  }
  .studio-filter:has(.studio-filter-input:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  .video-card__kicker {
    margin: 0 0 8px;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 16px;
    text-transform: uppercase;
  }
  .directory .video-card__external {
    top: 46px;
  }
  @media (max-width: 699px) {
    .studio-filter {
      min-height: 44px;
      padding: 0 12px;
    }
  }
  .directory:has(#studio-kind-studio:checked) .video-card:not([data-kind="studio"]),
  .directory:has(#studio-kind-person:checked) .video-card:not([data-kind="person"]) {
    display: none;
  }
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const kind = params.get("kind");
  if (kind) {
    const selected = document.getElementById(`studio-kind-${kind}`);
    if (selected instanceof HTMLInputElement) selected.checked = true;
  }

  document.querySelectorAll<HTMLInputElement>('input[name="studio-kind"]').forEach((input) => {
    input.addEventListener("change", () => {
      if (!input.checked) return;
      const url = new URL(window.location.href);
      if (input.value === "all") url.searchParams.delete("kind");
      else url.searchParams.set("kind", input.value);
      history.replaceState(null, "", url);
    });
  });
</script>
