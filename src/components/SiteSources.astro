---
import { GEO_CITATIONS } from "@/lib/site";
---

<section class="site-sources" aria-labelledby="site-sources-title">
  <h2 id="site-sources-title">Sources and quotations</h2>
  {
    GEO_CITATIONS.map((item) => (
      <blockquote cite={item.url}>
        <p>{item.quote}</p>
        <footer>
          —{" "}
          <cite>
            <a href={item.url} target="_blank" rel="noopener noreferrer">
              {item.name}
            </a>
          </cite>
        </footer>
      </blockquote>
    ))
  }
  <p>
    Each launch video on whatships.com cites the original public post on{" "}
    <a href="https://x.com/" target="_blank" rel="noopener noreferrer">X</a>.
    The catalog source lives at{" "}
    <a
      href="https://github.com/dingyi/whatships.com"
      target="_blank"
      rel="noopener noreferrer"
    >
      github.com/dingyi/whatships.com
    </a>.
  </p>
</section>
