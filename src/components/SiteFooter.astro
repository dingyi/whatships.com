---
import { ASK_AI_LINKS } from "@/lib/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <a class="wordmark footer-mark" href="/">whatships.com</a>
  <nav class="footer-nav" aria-label="Footer navigation">
    <a href="/about/">About</a>
    <span aria-hidden="true">·</span>
    <a href="/contact/">Contact</a>
    <span aria-hidden="true">·</span>
    <a href="/privacy/">Privacy</a>
    <span aria-hidden="true">·</span>
    <a href="/terms/">Terms</a>
    <span aria-hidden="true">·</span>
    <a href="/developers/">Developers</a>
    <span aria-hidden="true">·</span>
    <a href="/tools/">Tools</a>
    <span aria-hidden="true">·</span>
    <a href="/studios/">Studios</a>
    <span aria-hidden="true">·</span>
    <a href="/submit/">Submit ↗</a>
    <span aria-hidden="true">·</span>
    <a href="/llms.txt" target="_blank" rel="noopener noreferrer">llms.txt ↗</a>
  </nav>
  <div class="footer-ask">
    <p class="footer-ask-label">Ask about whatships.com on</p>
    <ul class="footer-ask-list" aria-label="Ask an AI about whatships.com">
      {
        ASK_AI_LINKS.map((ai) => (
          <li>
            <a
              class="ask-ai-link"
              href={ai.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ask about whatships.com on ${ai.name}`}
              title={`Ask about whatships.com on ${ai.name}`}
            >
              <img
                class="ask-ai-icon"
                src={ai.icon}
                alt=""
                width="16"
                height="16"
                aria-hidden="true"
                data-mono={ai.mono ? "true" : undefined}
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <p class="footer-meta">© {year} whatships.com</p>
</footer>
